{
  "name": "1j0y",
  "version": "1.0.0",
  "description": "WebAssembly joystick input library with TypeScript wrapper",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:wasm": "make",
    "build:vite": "vite build",
    "build": "npm run build:wasm && npm run build:vite",
    "dev": "vite build --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "joystick",
    "gamepad",
    "webassembly",
    "wasm",
    "emscripten",
    "input",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/emscripten": "^1.39.13",
    "@types/node": "^20.11.5",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-dts": "^3.7.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ford442/1j0y.git"
  }
}
